# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# development | production
ENV=development
LOG_LEVEL=INFO

# SQLAlchemy async URL (aiomysql driver). Points at a local MySQL/MariaDB
# instance (e.g. XAMPP) — create the `aidigiplanner` (and `aidigiplanner_test`
# for the test suite) databases there before running migrations.
DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/aidigiplanner?charset=utf8mb4

# Separate database used only by the test suite (pytest). Never shares data
# with DATABASE_URL above — the test session fixture drops and recreates its
# schema on every run.
TEST_DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/aidigiplanner_test?charset=utf8mb4

# HS256 signing secret for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Single-use token TTLs. PASSWORD_RESET_TTL_MINUTES governs the reset
# session token issued by /verify-reset-otp (used by /reset-password), not
# the OTP itself — see OTP_TTL_MINUTES below.
PASSWORD_RESET_TTL_MINUTES=60

# Forgot-password OTP: how long the emailed 6-digit code is valid, and how
# many wrong guesses before it's locked out (requiring a fresh one).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Register/resend-verification OTP (the 6-box "Verify your email" code).
# Reuses OTP_MAX_ATTEMPTS above for its lockout.
EMAIL_VERIFICATION_OTP_TTL_MINUTES=15

# In-memory rate limiter thresholds for auth endpoints.
RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_EMAIL_PER_MINUTE=5

# Outbound email (SMTP). Leave SMTP_HOST empty to fall back to
# ConsoleEmailService (logs tokens/credentials instead of sending) — see
# app/modules/email/provider.py. For Gmail, SMTP_PASS must be an App
# Password (https://myaccount.google.com/apppasswords), not the account
# password — Gmail rejects plain account passwords over SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_USE_TLS=true
SMTP_FROM_NAME=AI Social Planner

# --- Creative generation ---
# See the "Creative generation" section of README.md for the full setup
# (Redis + ffmpeg + running the arq worker process).

# Broker for the arq job queue that runs creative-generation jobs. A local
# Redis is enough for dev — see README.md for a Windows-friendly setup with
# no Docker/WSL2 required.
REDIS_URL=redis://127.0.0.1:6379/0

# Where generated images/videos are stored. "local" is the only backend
# implemented so far (LocalDiskStorage) — see app/modules/storage/.
CREATIVE_STORAGE_BACKEND=local
CREATIVE_STORAGE_LOCAL_ROOT=./storage/creatives

# Gemini API key. Deliberately has NO CREATIVE_ prefix (unlike the other
# CREATIVE_* settings below) so it's the exact env var name Google's own
# docs use. Leave empty to use the deterministic mock providers everywhere
# (zero cost, no network) — this is what the test suite does, and what a
# generate request's dry_run:true flag forces even when this IS set.
GEMINI_API_KEY=

# Cost guardrails: a generate request is rejected before anything is
# enqueued if its pre-flight ₹ estimate exceeds the per-run cap, or if it
# would push the company's total spend today over the per-day cap.
CREATIVE_MAX_COST_PER_RUN_INR=500
CREATIVE_MAX_COST_PER_DAY_INR=2000

# How long to poll a long-running Gemini video generation operation
# (Veo/Omni) before giving up.
CREATIVE_VIDEO_POLL_INTERVAL_S=10
CREATIVE_VIDEO_POLL_TIMEOUT_S=600
